{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-pro-max.dev/schemas/product-model.schema.json",
  "title": "Product Pro Max Product Model",
  "type": "object",
  "required": [
    "model_version",
    "canonical_language",
    "lifecycle",
    "tracks",
    "loops",
    "gates",
    "decisions",
    "project_statuses"
  ],
  "properties": {
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "canonical_language": {
      "const": "en"
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "ordered",
        "cycles"
      ],
      "additionalProperties": false,
      "properties": {
        "ordered": {
          "const": true
        },
        "cycles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "purpose",
              "phases"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "phases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label",
                    "purpose"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "loops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/loopItem"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/semanticItem"
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/semanticItem"
      }
    },
    "project_statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/semanticItem"
      }
    }
  },
  "$defs": {
    "namedItem": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "loopItem": {
      "type": "object",
      "required": [
        "id",
        "label",
        "motion"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "motion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semanticItem": {
      "type": "object",
      "required": [
        "id",
        "label",
        "meaning"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
